# ========================================================
# Mentora v1.0 - Production Environment Configuration
# ========================================================
# IMPORTANT: Copy this file to .env and replace all placeholder
# values with secure, cryptographically random secrets before
# deploying to production.
# ========================================================

# General Application Environment
APP_ENV=production
NODE_ENV=production

# --------------------------------------------------------
# Node.js + Express Backend Configuration
# --------------------------------------------------------
PORT=5000
# Production PostgreSQL Connection URL
DATABASE_URL="postgresql://mentora_admin:CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD@postgres:5432/mentora_prod?schema=public&sslmode=prefer"

# Secure Cryptographic Secret for JWT Signing (Min 32 characters)
JWT_SECRET=REPLACE_WITH_A_64_CHAR_HEX_OR_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated or single domain)
CORS_ORIGIN="https://mentora.yourdomain.com,http://localhost"

# Internal AI Service URL (Docker service name or internal private IP)
AI_SERVICE_URL=http://ai-service:8000

# File Upload Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=25

# --------------------------------------------------------
# Python + FastAPI AI Service Configuration
# --------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
LOG_LEVEL=INFO

# Ollama LLM & Embedding Service Endpoint
# In production, point to a dedicated inference server or host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# Persistent ChromaDB Directory
CHROMA_PERSIST_DIRECTORY=/app/chroma_data
CHROMA_COLLECTION=mentora_study_materials

# RAG & Chunking Parameters
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=90
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.35
RAG_MAX_CONTEXT_TOKENS=3000

# LLM Inference Controls
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=1500
LLM_TIMEOUT_SECONDS=180

# --------------------------------------------------------
# React + Vite Frontend Configuration
# --------------------------------------------------------
# Set to relative '/api' if hosted behind reverse proxy (Nginx)
# or full URL 'https://api.yourdomain.com/api' for decoupled deployments
VITE_API_URL=/api
