# ========================================================
# Mentora - Environment Configuration Template
# ========================================================

# General Configuration
APP_ENV=development

# --------------------------------------------------------
# Node.js + Express Backend Configuration
# --------------------------------------------------------
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentora?schema=public"
JWT_SECRET=mentora_super_secret_jwt_key_change_in_production
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# --------------------------------------------------------
# Python + FastAPI AI Service Configuration
# --------------------------------------------------------
AI_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION=mentora_documents

CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5

# --------------------------------------------------------
# React + Vite Frontend Configuration
# --------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

