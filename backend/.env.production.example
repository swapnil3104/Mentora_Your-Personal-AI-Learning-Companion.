# Mentora Backend - Production Environment Configuration
NODE_ENV=production
PORT=5000

# Production PostgreSQL Database Connection
DATABASE_URL="postgresql://mentora_admin:CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD@postgres:5432/mentora_prod?schema=public&sslmode=prefer"

# Secure Cryptographic Secret for JWT Signing (Min 32 characters)
JWT_SECRET=REPLACE_WITH_A_64_CHAR_HEX_OR_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN="https://mentora.yourdomain.com,http://localhost"

# Internal Private AI Service URL
AI_SERVICE_URL=http://ai-service:8000

# Persistent Secure Upload Directory
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=25
