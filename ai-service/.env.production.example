# Mentora AI Service - Production Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Ollama LLM & Embedding Service Endpoint (Inference Server)
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen2.5:3b

# Persistent ChromaDB Storage
CHROMA_PERSIST_DIRECTORY=/app/chroma_data
CHROMA_COLLECTION_NAME=mentora_study_materials

# Chunking Configuration
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=90

# RAG Configuration
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.35
RAG_MAX_CONTEXT_TOKENS=3000

# LLM Inference Configuration
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=1500
LLM_TIMEOUT_SECONDS=180

# CORS Allowed Origins
CORS_ORIGINS="https://mentora.yourdomain.com,http://localhost"
